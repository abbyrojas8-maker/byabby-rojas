# Copiá este archivo como ".env" y completá tus claves

# HeyGen - https://app.heygen.com/settings/api
HEYGEN_API_KEY=tu_clave_api_aqui

# ID de tu avatar en HeyGen (lo encontrás en la sección "Avatars")
AVATAR_ID=tu_avatar_id_aqui

# ID de tu voz clonada en HeyGen (sección "Voices" → "Instant Clone")
VOICE_ID=tu_voz_id_aqui
